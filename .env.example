# ---- Local LLM (Docker Hub: ollama/ollama) ----
# OpenAI-compatible base URL exposed by Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Chat model to pull inside the Ollama container, e.g. llama3.1, mistral, qwen2.5
LLM_MODEL=llama3.1

# Embedding model (pulled inside Ollama). nomic-embed-text is small + fast.
EMBED_MODEL=nomic-embed-text

# Generation controls
LLM_TEMPERATURE=0.1
# Q1/Q2 feed whole documents to the model — keep this large so nothing is truncated.
LLM_NUM_CTX=16384

# ---- Retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# ---- Paths (relative to project root) ----
DATA_DIR=data
INDEX_DIR=faiss_index
OUTPUT_DIR=outputs
